{
  "manifest_version": 3,
  "name": "Resume Manager Apply",
  "version": "0.4.1",
  "description": "Manually prepare, review, and fill job applications with Resume Manager.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabGroups",
    "scripting",
    "alarms",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:17373/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Resume Manager Apply",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
